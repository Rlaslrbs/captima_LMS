# 고정 주소(named tunnel) 설정 예시
# 1) 이 파일을 %USERPROFILE%\.cloudflared\config.yml 로 복사하고 아래 값을 고친다.
# 2) tunnel-id 는 'cloudflared tunnel create munje-note' 를 실행했을 때 나온 값이다.
# 3) hostname 은 Cloudflare에 올린 내 도메인 주소다 (예: munje.내도메인.com).

tunnel: munje-note
credentials-file: C:\Users\내계정\.cloudflared\<tunnel-id>.json

ingress:
  - hostname: munje.내도메인.com
    service: http://127.0.0.1:4000
  # 나머지 요청은 모두 거절
  - service: http_status:404
