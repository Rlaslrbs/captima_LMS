{
  "name": "munje-note-platform",
  "private": true,
  "type": "module",
  "description": "문제노트 베타 플랫폼 (사용자 웹 + 관리자 웹 + MySQL). Node 24 내장 기능 + mysql2 하나",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/server.js",
    "import": "node --env-file-if-exists=.env server/import.js",
    "test": "node --test server/insight/test/engine.test.mjs server/insight/test/sim.test.mjs",
    "test:mysql": "node --env-file-if-exists=.env --test server/mysql/sync.test.mjs",
    "dev": "node --env-file-if-exists=.env server/server.js",
    "setup": "node tools/setup.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "mysql2": "^3.24.6"
  }
}
