# 이 파일을 .env로 복사해서 값을 채워요. .env는 git에 올라가지 않아요 (.gitignore).
# Gemini API 키: 각자 https://aistudio.google.com/apikey 에서 만들거나, 팀에서 따로(메신저 등) 받아요.
GEMINI_API_KEY=
# 관리자 화면을 비밀번호로 보호하고 싶을 때 (비우면 로컬 비밀 주소로 동작)
ADMIN_PASSWORD=
# PORT=4000
# HOST=127.0.0.1
# MySQL 접속 (server/mysql/schema.sql을 먼저 실행해 둔 DB). 비밀번호는 이 파일(.env)에만 써요
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=problem_solving_site
# 백업(mysqldump) 프로그램 위치. PATH에 있으면 비워 둬요 (예: /opt/homebrew/bin/mysqldump)
# MYSQLDUMP_BIN=
# BACKUP_DIR=data/backups
