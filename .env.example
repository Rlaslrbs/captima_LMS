# 이 파일을 .env로 복사해서 값을 채워요. .env는 git에 올라가지 않아요 (.gitignore).
# Gemini API 키: 각자 https://aistudio.google.com/apikey 에서 만들거나, 팀에서 따로(메신저 등) 받아요.
GEMINI_API_KEY=
# 관리자 화면을 비밀번호로 보호하고 싶을 때 (비우면 로컬 비밀 주소로 동작)
ADMIN_PASSWORD=
# PORT=4000
# HOST=127.0.0.1
# MySQL 접속 (docs/db/MySQL_서버연결_프롬프트.md 또는 tools/mysql-setup.mjs로 준비한 DB). 비밀번호는 이 파일(.env)에만 써요
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=problem_solving_site
# 표 만들기 권한이 없는 서버 계정일 때만: tools/mysql-setup.mjs schema 단계에서 잠깐 쓰는 관리자 계정 (끝나면 지워요)
# MYSQL_ADMIN_USER=
# MYSQL_ADMIN_PASSWORD=
# 백업(mysqldump) 프로그램 위치. PATH에 있으면 비워 둬요 (예: /opt/homebrew/bin/mysqldump)
# MYSQLDUMP_BIN=
# BACKUP_DIR=data/backups
